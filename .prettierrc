{
      "arrowParens": "always",
      "jsxSingleQuote": false,
      "quoteProps": "as-needed",
      "semi": true,
      "singleQuote": true,
      "trailingComma": "all",

      "embeddedLanguageFormatting": "auto",
      "htmlWhitespaceSensitivity": "css",
      "vueIndentScriptAndStyle": false,

      "insertPragma": false,
      "proseWrap": "preserve",
      "requirePragma": false,

      "printWidth": 140,
      "tabWidth": 6,
      "bracketSameLine": false,
      "bracketSpacing": true,
      "useTabs": false
}
